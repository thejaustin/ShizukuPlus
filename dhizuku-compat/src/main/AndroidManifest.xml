<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Forwards go to the Shizuku+ manager by package, so it must be visible on Android 11+. -->
    <queries>
        <package android:name="af.shizuku.plus.api" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">

        <!-- The ONE place in this repo allowed to claim a Dhizuku authority (see CLAUDE.md and
             pre-push guard check 27, which skips this module on purpose). Dhizuku-API <= 2.4
             hardcodes it. It makes this APK uninstallable next to the real Dhizuku app, by design. -->
        <provider
            android:name=".DhizukuProviderProxy"
            android:authorities="com.rosan.dhizuku.server.provider"
            android:exported="true" />

        <!-- Dhizuku-API <= 2.4 requests permission with this implicit intent. -->
        <activity
            android:name=".ForwardPermissionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.rosan.dhizuku.action.request.permission" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
