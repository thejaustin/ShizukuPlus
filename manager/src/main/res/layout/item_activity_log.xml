<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Timeline Rail with pulsing dot node -->
    <af.shizuku.manager.home.changelog.TimelineRailView
        android:id="@+id/rail"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" />

    <!-- Event type color bar indicator -->
    <View
        android:id="@+id/event_indicator"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/shape_event_indicator" />

    <!-- App icon in tonal container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:layout_gravity="top"
        android:layout_marginTop="6dp"
        app:cardElevation="0dp"
        app:shapeAppearance="?attr/shapeAppearanceCornerMedium"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Content column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <!-- App name + event type chip + stack badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:maxLines="2" />

            <com.google.android.material.chip.Chip
                android:id="@+id/stack_chip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:visibility="gone"
                android:textColor="?attr/colorPrimary"
                app:chipBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:chipMinHeight="22dp"
                app:chipStartPadding="6dp"
                app:chipEndPadding="6dp"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/event_chip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:clickable="false"
                android:focusable="false"
                app:chipMinHeight="22dp"
                app:chipStartPadding="6dp"
                app:chipEndPadding="6dp"
                app:ensureMinTouchTargetSize="false" />

        </LinearLayout>

        <!-- Action text -->
        <TextView
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="6" />

        <!-- Package + timestamp row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/package_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="2" />

            <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Expanded stacked occurrences container -->
        <LinearLayout
            android:id="@+id/expanded_stack_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:paddingStart="8dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
