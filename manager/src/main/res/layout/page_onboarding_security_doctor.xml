<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="@dimen/onboarding_page_padding_top"
        android:paddingBottom="16dp">

        <ImageView
            style="@style/CardIcon.Droplet"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="16dp"
            android:src="@drawable/ic_shield_24"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/onboarding_security_doctor_title"
            android:textAppearance="?textAppearanceHeadlineMedium"
            android:textColor="?colorOnSurface"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_security_doctor_desc"
            android:textAppearance="?textAppearanceBodyLarge"
            android:textColor="?colorOnSurfaceVariant"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="20dp" />

        <!-- The two switches as one grouped card, like a settings section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?colorSurfaceContainerHigh"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraLarge"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- Network Trust Shield switch: the whole row toggles it -->
                <LinearLayout
                    android:id="@+id/row_network_guard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_network_guard_title"
                            android:textAppearance="?textAppearanceBodyLarge"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_network_guard_desc"
                            android:textAppearance="?textAppearanceBodyMedium"
                            android:textColor="?colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_network_guard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <!-- Watchdog switch -->
                <LinearLayout
                    android:id="@+id/row_watchdog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_watchdog_title"
                            android:textAppearance="?textAppearanceBodyLarge"
                            android:textColor="?colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_watchdog_desc"
                            android:textAppearance="?textAppearanceBodyMedium"
                            android:textColor="?colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_watchdog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- How much Service Doctor helps on its own -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/onboarding_assistant_title"
            android:textAppearance="?textAppearanceTitleMedium"
            android:textColor="?colorOnSurface" />

        <!-- Read out when the level changes -->
        <TextView
            android:id="@+id/assistant_level_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?colorOnSurfaceVariant" />

        <!-- Connected button group (M3E 2.3); the code stacks it at very large font sizes -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/assistant_level_group"
            style="@style/Widget.Material3Expressive.MaterialButtonToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assistant_off"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="8dp"
                android:text="@string/onboarding_assistant_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assistant_quiet"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="8dp"
                android:text="@string/onboarding_assistant_quiet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assistant_balanced"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="8dp"
                android:text="@string/onboarding_assistant_balanced" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/assistant_active"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="8dp"
                android:text="@string/onboarding_assistant_active" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Preview of what the chosen level shows. One screen reader node with a per-level
             description; nothing in it can be tapped. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/assistant_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            app:cardBackgroundColor="?colorSurfaceContainer"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraLarge"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/assistant_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/onboarding_assistant_preview_label"
                    android:textAppearance="?textAppearanceLabelMedium"
                    android:textColor="?colorOnSurfaceVariant" />

                <!-- Off -->
                <TextView
                    android:id="@+id/preview_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_assistant_preview_off"
                    android:textAppearance="?textAppearanceBodyMedium"
                    android:textColor="?colorOnSurfaceVariant" />

                <!-- Quiet -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/preview_chip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_assistant_preview_chip"
                    app:chipIcon="@drawable/ic_medical_services_24"
                    app:chipIconTint="?colorPrimary"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Balanced: a Service Doctor row as the Doctor draws it (item_doctor_check) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preview_fix_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?colorSurfaceContainerHigh"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_server_error_24"
                            android:contentDescription="@null"
                            app:tint="?colorError" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_v2_preview_card_title"
                                android:textAppearance="?textAppearanceTitleMedium"
                                android:textColor="?colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/onboarding_v2_preview_card_status"
                                android:textAppearance="?textAppearanceBodyMedium"
                                android:textColor="?colorOnSurfaceVariant" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            style="?attr/materialButtonTonalStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="@string/doctor_button_fix" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Active: the notification as well, laid out like a system one -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preview_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="?colorSurfaceContainerHighest"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/onboarding_preview_badge"
                            android:backgroundTint="?colorPrimary"
                            android:padding="6dp"
                            android:src="@drawable/ic_notification_icon"
                            android:contentDescription="@null"
                            app:tint="?colorOnPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/preview_notification_app"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?textAppearanceLabelMedium"
                                android:textColor="?colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/onboarding_v2_preview_notification_title"
                                android:textAppearance="?textAppearanceTitleSmall"
                                android:textColor="?colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/onboarding_v2_preview_notification_text"
                                android:textAppearance="?textAppearanceBodyMedium"
                                android:textColor="?colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/home_root_button_start"
                                android:textAppearance="?textAppearanceLabelLarge"
                                android:textColor="?colorPrimary" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
