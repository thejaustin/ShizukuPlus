<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/dialog_top_padding"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?android:dialogPreferredPadding"
        android:showDividers="middle"
        android:divider="@drawable/spacing_list_item_vertical"
        android:orientation="vertical">

        <!-- Where pairing stands (PairingStatePanel, inline, added in code). -->
        <FrameLayout
            android:id="@+id/state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_adb_pairing_paring_code"
            android:visibility="gone"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerMedium"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:digits="0123456789"
                android:maxLength="6"
                android:maxLines="1"
                android:letterSpacing="0.15"
                android:gravity="center"
                android:textAppearance="?textAppearanceHeadlineSmall"
                tools:text="123456" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_adb_port"
            android:visibility="gone"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerMedium"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:textAppearance="?textAppearanceBodyLarge"
                tools:text="12345" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>