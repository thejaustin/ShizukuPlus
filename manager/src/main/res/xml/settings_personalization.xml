<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_color_theme"
        android:title="@string/settings_personalization_category_color_theme"
        android:icon="@drawable/ic_palette_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.IntegerSegmentedControlPreference
            android:entries="@array/night_mode"
            android:entryValues="@array/night_mode_value"
            android:key="night_mode"
            android:title="@string/dark_theme"
            android:icon="@drawable/ic_outline_dark_mode_24" />
        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="dark_style"
            android:persistent="false"
            android:title="@string/settings_dark_style_title"
            android:icon="@drawable/ic_bedtime_24"
            android:entries="@array/dark_styles"
            android:entryValues="@array/dark_styles_value" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="high_contrast_mode"
            android:title="@string/settings_high_contrast_title"
            android:summary="@string/settings_high_contrast_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_contrast_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="use_system_color"
            android:title="@string/settings_use_system_color"
            android:icon="@drawable/ic_wallpaper_24" />

        <af.shizuku.manager.settings.AccentPickerPreference
            android:key="custom_accent"
            android:title="@string/settings_custom_accent_title"
            android:defaultValue="DEFAULT"
            android:entries="@array/custom_accents"
            android:entryValues="@array/custom_accents_values"
            android:icon="@drawable/ic_colorize_24" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="oneui_theme_enabled"
            android:title="@string/settings_oneui_theme"
            android:summary="@string/settings_oneui_theme_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_space_dashboard_24"
            app:badgeType="oneui" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_app_identity"
        android:title="@string/settings_personalization_category_app_identity"
        android:icon="@drawable/ic_sparkle_24"
        android:defaultValue="false">

        <Preference
            android:key="custom_icon_studio"
            android:title="@string/settings_custom_icon_studio_title"
            android:summary="@string/settings_custom_icon_studio_summary"
            android:icon="@drawable/ic_sparkle_24" />

        <af.shizuku.manager.settings.AppIconTilePickerPreference
            android:key="app_icon_alias" />

        <EditTextPreference
            android:key="custom_app_name"
            android:title="@string/settings_custom_app_name_title"
            android:summary="@string/settings_custom_app_name_summary"
            android:dialogTitle="@string/settings_custom_app_name_dialog_title"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/ic_edit_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_shape_style"
        android:title="@string/settings_personalization_category_shape_style"
        android:icon="@drawable/ic_window_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="icon_style"
            android:title="@string/settings_icon_style"
            android:defaultValue="twotone"
            android:entries="@array/icon_styles"
            android:entryValues="@array/icon_styles_value"
            android:icon="@drawable/ic_category_24" />

        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="icon_color_mode"
            android:title="@string/settings_icon_color_mode"
            android:summary="@string/settings_icon_color_mode_summary"
            android:defaultValue="uniform"
            android:entries="@array/icon_color_modes"
            android:entryValues="@array/icon_color_modes_value"
            android:dependency="icon_style"
            android:icon="@drawable/ic_invert_colors_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="expressive_shapes"
            android:title="@string/settings_expressive_shapes"
            android:summary="@string/settings_expressive_shapes_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_interests_24" />

        <af.shizuku.manager.settings.ShapeStylePickerPreference
            android:key="shape_style"
            android:title="@string/settings_shape_style"
            android:defaultValue="modern"
            android:entries="@array/shape_styles"
            android:entryValues="@array/shape_styles_value"
            android:dependency="expressive_shapes"
            android:icon="@drawable/ic_settings_suggest_24" />

        <af.shizuku.manager.settings.ShapePickerPreference
            android:key="icon_morph_shape"
            android:title="@string/settings_icon_morph_shape_title"
            android:icon="@drawable/ic_interests_24"
            android:defaultValue="off" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="icon_morph_on_toggle"
            android:title="@string/settings_icon_morph_on_toggle_title"
            android:summary="@string/settings_icon_morph_on_toggle_summary"
            android:icon="@drawable/ic_animation_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.ShapePickerPreference
            android:key="icon_morph_off_shape"
            android:title="@string/settings_icon_morph_off_shape_title"
            android:icon="@drawable/ic_interests_24"
            android:defaultValue="circle" />

        <rikka.preference.SimpleMenuPreference
            android:key="icon_morph_mode"
            android:title="@string/settings_icon_morph_mode_title"
            android:entries="@array/icon_morph_modes"
            android:entryValues="@array/icon_morph_modes_values"
            android:defaultValue="spin"
            android:icon="@drawable/ic_animation_24" />


        <af.shizuku.manager.settings.SliderPreference
            android:key="corner_rounding_override"
            android:title="@string/settings_corner_rounding_override"
            android:defaultValue="default"
            android:entries="@array/corner_rounding_entries"
            android:entryValues="@array/corner_rounding_values"
            android:icon="@drawable/ic_rounded_corner_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_home_cards_outline"
            android:title="@string/settings_show_home_cards_outline"
            android:summary="@string/settings_show_home_cards_outline_summary"
            android:icon="@drawable/ic_border_style_24"
            android:defaultValue="false" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_motion_display"
        android:title="@string/settings_personalization_category_motion_haptics"
        android:icon="@drawable/ic_vibration_24"
        android:defaultValue="false">

        <af.shizuku.manager.settings.MotionControlsPreference
            android:key="motion_controls_card" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="follow_system_animations"
            android:title="@string/settings_follow_system_animations"
            android:summary="@string/settings_follow_system_animations_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_settings_suggest_24" />
        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="haptics_mode"
            android:persistent="false"
            android:title="@string/settings_haptics_mode_title"
            android:icon="@drawable/ic_vibration_24"
            android:entries="@array/haptics_modes"
            android:entryValues="@array/haptics_modes_value" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_layout_nav"
        android:title="@string/settings_personalization_category_layout_nav"
        android:icon="@drawable/ic_smartphone_24"
        android:defaultValue="false">

        <af.shizuku.manager.settings.DisplayOptionsGridPreference
            android:key="display_options_grid" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="one_handed_mode"
            android:title="@string/settings_one_handed_mode"
            android:summary="@string/settings_one_handed_mode_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_smartphone_24"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="floating_nav_enabled"
            android:title="@string/settings_floating_nav"
            android:summary="@string/settings_floating_nav_summary"
            android:icon="@drawable/ic_nav_apps_24"
            android:defaultValue="false"
            app:infoTitle="@string/settings_floating_nav"
            app:infoDetail="@string/settings_floating_nav_info"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="floating_nav_style"
            android:title="@string/settings_floating_nav_style_title"
            android:icon="@drawable/ic_space_dashboard_24"
            android:entries="@array/floating_nav_styles"
            android:entryValues="@array/floating_nav_styles_value"
            android:defaultValue="docked"
            android:dependency="floating_nav_enabled" />

        <androidx.preference.MultiSelectListPreference
            android:key="floating_nav_tabs"
            android:title="@string/settings_floating_nav_tabs_title"
            android:icon="@drawable/ic_label_24"
            android:entries="@array/floating_nav_optional_tabs"
            android:entryValues="@array/floating_nav_optional_tabs_value"
            android:defaultValue="@array/floating_nav_optional_tabs_value"
            android:dependency="floating_nav_enabled" />

        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="floating_nav_label_mode"
            android:title="@string/settings_floating_nav_label_mode"
            android:summary="@string/settings_floating_nav_label_mode_summary"
            android:defaultValue="labeled"
            android:entries="@array/floating_nav_label_modes"
            android:entryValues="@array/floating_nav_label_modes_value"
            android:dependency="floating_nav_enabled"
            android:icon="@drawable/ic_label_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="floating_nav_autohide"
            android:title="@string/settings_floating_nav_autohide"
            android:summary="@string/settings_floating_nav_autohide_summary"
            android:defaultValue="true"
            android:dependency="floating_nav_enabled"
            android:icon="@drawable/ic_vertical_align_bottom_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_app_interactions"
        android:title="@string/settings_main_nav_app_interactions_title"
        android:icon="@drawable/ic_swipe_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.SwipePreviewPreference
            android:key="swipe_preview" />

        <af.shizuku.manager.settings.SwipeActionRowPreference
            android:key="swipe_right_row"
            android:title="@string/swipe_actions_right_title"
            android:icon="@drawable/ic_arrow_forward_24" />

        <af.shizuku.manager.settings.SwipeActionRowPreference
            android:key="swipe_left_row"
            android:title="@string/swipe_actions_left_title"
            android:icon="@drawable/ic_arrow_back_24" />

        <af.shizuku.manager.settings.SwipeActionRowPreference
            android:key="long_press_row"
            android:title="@string/swipe_actions_long_press_title"
            android:icon="@drawable/ic_touch_app_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_app_descriptions"
            android:title="@string/settings_show_app_descriptions"
            android:summary="@string/settings_show_app_descriptions_summary"
            android:icon="@drawable/ic_outline_info_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_plus_feature_hints"
            android:title="@string/settings_show_plus_feature_hints"
            android:summary="@string/settings_show_plus_feature_hints_summary"
            android:icon="@drawable/ic_bolt_24"
            android:defaultValue="true"
            android:dependency="show_app_descriptions" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_home_screen"
        android:title="@string/settings_personalization_category_home_screen"
        android:icon="@drawable/ic_nav_home_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_activity_log_home"
            android:title="@string/settings_show_activity_log_home"
            android:icon="@drawable/ic_article_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="lock_home_layout"
            android:title="@string/settings_lock_home_layout"
            android:summary="@string/settings_lock_home_layout_summary"
            android:icon="@drawable/ic_shield_24"
            android:defaultValue="false" />

        <Preference
            android:key="rearrange_home_cards"
            android:title="@string/settings_rearrange_home_cards"
            android:summary="@string/settings_rearrange_home_cards_summary"
            android:icon="@drawable/ic_space_dashboard_24" />

        <af.shizuku.manager.settings.StatusOutlineMasterPreference
            android:key="status_card_outline_card" />


        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="companion_mode"
            android:title="@string/settings_companion_mode"
            android:summary="@string/settings_companion_mode_summary"
            android:icon="@drawable/ic_baseline_link_24"
            android:defaultValue="false" />

        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="changelog_style"
            android:title="@string/settings_changelog_style"
            android:defaultValue="timeline"
            android:entries="@array/changelog_styles"
            android:entryValues="@array/changelog_styles_value"
            android:icon="@drawable/ic_article_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_language"
        android:title="@string/settings_personalization_category_language"
        android:icon="@drawable/ic_outline_translate_24"
        android:defaultValue="true">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:key="language"
            android:title="@string/settings_language"
            android:icon="@drawable/ic_outline_translate_24" />

        <Preference
            android:key="translation"
            android:title="@string/settings_translation"
            android:icon="@drawable/ic_outline_translate_24"
            app:widgetLayout="@layout/preference_widget_open_in_new" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
