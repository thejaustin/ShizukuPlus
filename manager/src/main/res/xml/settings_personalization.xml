<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_color_theme"
        android:title="Color &amp; Theme"
        android:defaultValue="true">

        <af.shizuku.manager.settings.IntegerSimpleMenuPreference
            android:entries="@array/night_mode"
            android:entryValues="@array/night_mode_value"
            android:key="night_mode"
            android:summary="%s"
            android:title="@string/dark_theme"
            android:icon="@drawable/ic_outline_dark_mode_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="black_night_theme"
            android:summary="@string/settings_black_night_theme_summary"
            android:title="@string/settings_black_night_theme"
            android:icon="@drawable/ic_bedtime_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="use_system_color"
            android:title="@string/settings_use_system_color"
            android:icon="@drawable/ic_palette_24" />

        <rikka.preference.SimpleMenuPreference
            android:key="custom_accent"
            android:title="Custom Accent Color"
            android:summary="Choose a color when Dynamic Color is off"
            android:defaultValue="DEFAULT"
            android:entries="@array/custom_accents"
            android:entryValues="@array/custom_accents_values"
            android:icon="@drawable/ic_palette_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="oneui_theme_enabled"
            android:title="@string/settings_oneui_theme"
            android:summary="@string/settings_oneui_theme_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_palette_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="one_handed_mode"
            android:title="@string/settings_one_handed_mode"
            android:summary="@string/settings_one_handed_mode_summary"
            android:defaultValue="false"
            android:dependency="oneui_theme_enabled"
            android:icon="@drawable/ic_settings_suggest_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_shape_style"
        android:title="Shape &amp; Icon Style"
        android:defaultValue="true">

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="expressive_shapes"
            android:title="@string/settings_expressive_shapes"
            android:summary="@string/settings_expressive_shapes_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_palette_24" />

        <rikka.preference.SimpleMenuPreference
            android:key="shape_style"
            android:title="@string/settings_shape_style"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="zen"
            android:entries="@array/shape_styles"
            android:entryValues="@array/shape_styles_value"
            android:dependency="expressive_shapes"
            android:icon="@drawable/ic_settings_suggest_24" />

        <rikka.preference.SimpleMenuPreference
            android:key="icon_style"
            android:title="@string/settings_icon_style"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="standard"
            android:entries="@array/icon_styles"
            android:entryValues="@array/icon_styles_value"
            android:icon="@drawable/ic_settings_suggest_24" />

        <rikka.preference.SimpleMenuPreference
            android:key="icon_color_mode"
            android:title="@string/settings_icon_color_mode"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="uniform"
            android:entries="@array/icon_color_modes"
            android:entryValues="@array/icon_color_modes_value"
            android:icon="@drawable/ic_palette_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_motion"
        android:title="Motion"
        android:defaultValue="true">

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="expressive_animations"
            android:title="@string/settings_expressive_animations"
            android:summary="@string/settings_expressive_animations_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_outline_play_arrow_24" />

        <rikka.preference.SimpleMenuPreference
            android:key="animation_intensity"
            android:title="@string/settings_animation_intensity"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="2"
            android:entries="@array/animation_intensities"
            android:entryValues="@array/animation_intensities_value"
            android:dependency="expressive_animations"
            android:icon="@drawable/ic_bolt_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="haptic_feedback"
            android:title="@string/settings_haptic_feedback"
            android:summary="@string/settings_haptic_feedback_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_bolt_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_display"
        android:title="@string/settings_display_category"
        android:defaultValue="true">

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="edge_to_edge_enabled"
            android:title="@string/settings_edge_to_edge"
            android:summary="@string/settings_edge_to_edge_summary"
            android:defaultValue="true"
            android:icon="@drawable/ic_window_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="blur_ui_enabled"
            android:title="@string/settings_blur_ui"
            android:summary="@string/settings_blur_ui_summary"
            android:defaultValue="false"
            android:icon="@drawable/ic_palette_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_home_screen"
        android:title="Home Screen"
        android:defaultValue="true">

        <af.shizuku.manager.settings.HomeLayoutSimulatorPreference
            android:key="home_layout_simulator" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_terminal_home"
            android:title="@string/settings_show_terminal_home"
            android:icon="@drawable/ic_terminal_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_automation_home"
            android:title="@string/settings_show_automation_home"
            android:icon="@drawable/ic_integration_instructions_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_learn_more_home"
            android:title="@string/settings_show_learn_more_home"
            android:icon="@drawable/ic_outline_info_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_start_adb_home"
            android:title="@string/settings_show_start_adb_home"
            android:icon="@drawable/ic_adb_24"
            android:defaultValue="false" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_activity_log_home"
            android:title="@string/settings_show_activity_log_home"
            android:icon="@drawable/ic_article_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_status_card_outline"
            android:title="@string/settings_show_status_card_outline"
            android:summary="@string/settings_show_status_card_outline_summary"
            android:icon="@drawable/ic_palette_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="show_backup_home"
            android:title="@string/home_backup_title"
            android:icon="@drawable/ic_folder_24"
            android:defaultValue="false" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="companion_mode"
            android:title="@string/settings_companion_mode"
            android:summary="@string/settings_companion_mode_summary"
            android:icon="@drawable/ic_baseline_link_24"
            android:defaultValue="false" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_language"
        android:title="Language"
        android:defaultValue="false">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:key="language"
            android:title="@string/settings_language"
            android:icon="@drawable/ic_outline_translate_24" />

        <Preference
            android:key="translation"
            android:title="@string/settings_translation"
            android:icon="@drawable/ic_outline_translate_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
