<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_about_app"
        android:title="@string/settings_about_category_app_info"
        app:collapsible="false">

        <Preference
            android:key="version"
            android:title="@string/settings_version"
            android:icon="@drawable/ic_info_24" />

        <Preference
            android:key="changelog"
            android:title="@string/changelog_title"
            android:summary="@string/changelog_earlier_releases"
            android:icon="@drawable/ic_history_24" />

        <Preference
            android:key="feature_tour"
            android:title="@string/onboarding_take_tour"
            android:summary="@string/onboarding_take_tour_summary"
            android:icon="@drawable/ic_sparkle_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_about_updates"
        android:title="@string/settings_about_category_updates"
        app:collapsible="false">

        <Preference
            android:key="check_for_update"
            android:title="@string/settings_check_for_update_title"
            android:summary="@string/settings_check_for_update_summary"
            android:icon="@drawable/ic_update_24" />

        <Preference
            android:key="update_app_database"
            android:title="@string/settings_update_app_database"
            android:summary="@string/settings_update_app_database_summary"
            android:icon="@drawable/ic_autorenew" />

        <af.shizuku.manager.settings.SegmentedControlPreference
            android:key="update_channel"
            android:title="@string/settings_update_channel_title"
            android:icon="@drawable/ic_science_24"
            android:entries="@array/update_channel_entries"
            android:entryValues="@array/update_channel_values"
            android:defaultValue="stable" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="auto_update_enabled"
            android:title="@string/settings_auto_update_title"
            android:summary="@string/settings_auto_update_summary"
            android:icon="@drawable/ic_autorenew"
            android:defaultValue="true" />

        <rikka.preference.SimpleMenuPreference
            android:key="update_check_interval"
            android:dependency="auto_update_enabled"
            android:title="@string/settings_update_check_interval_title"
            android:entries="@array/update_check_interval_entries"
            android:entryValues="@array/update_check_interval_values"
            android:defaultValue="0"
            android:summary="%s"
            android:icon="@drawable/ic_notifications_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="auto_install_enabled"
            android:dependency="auto_update_enabled"
            android:title="@string/settings_auto_install_title"
            android:summary="@string/settings_auto_install_summary"
            android:icon="@drawable/ic_install_24"
            android:defaultValue="false" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_about_project"
        android:title="@string/settings_about_category_project"
        app:collapsible="false">

        <Preference
            android:key="source_code"
            android:title="@string/about_view_source_code_title"
            android:summary="https://github.com/thejaustin/ShizukuPlus"
            android:icon="@drawable/ic_baseline_link_24" />

        <Preference
            android:key="help"
            android:title="@string/settings_help"
            android:icon="@drawable/ic_help_outline_24" />

        <Preference
            android:key="report_bug"
            android:title="@string/settings_report_bug"
            android:icon="@drawable/ic_bug_report_24" />

        <Preference
            android:key="open_source_licenses"
            android:title="@string/settings_open_source_licenses"
            android:summary="@string/settings_open_source_licenses_summary"
            android:icon="@drawable/ic_article_24" />

        <Preference
            android:key="nav_developer_options"
            android:title="@string/settings_developer_options"
            android:summary="@string/settings_developer_options_summary"
            android:icon="@drawable/ic_terminal_24"
            android:fragment="af.shizuku.manager.settings.DeveloperOptionsFragment"
            android:visible="false" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
