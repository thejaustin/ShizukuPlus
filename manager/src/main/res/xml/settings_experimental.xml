<?xml version="1.0" encoding="utf-8"?>
<!-- The one home for features still being built. The first categories are open to everyone; the
     last ("Developer previews", key kept from the old Developer options category) holds the riskier
     ones and is only shown, and searchable, once Developer options are unlocked. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_experimental_features"
        android:title="@string/settings_experimental_category_personalization"
        android:icon="@drawable/ic_science_24"
        app:collapsible="false">

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="experimental_app_identity"
            android:persistent="false"
            android:title="@string/settings_experimental_app_identity_title"
            android:summary="@string/settings_experimental_app_identity_summary"
            android:icon="@drawable/ic_sparkle_24" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="device_control_home_enabled"
            android:title="@string/settings_device_control_home_title"
            android:summary="@string/settings_device_control_home_summary"
            android:icon="@drawable/ic_devices_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_experimental_color"
        android:title="@string/settings_experimental_category_color"
        android:icon="@drawable/ic_palette_24"
        app:collapsible="false">

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="experimental_color_schemes"
            android:title="@string/settings_experimental_color_schemes_title"
            android:summary="@string/settings_experimental_color_schemes_summary"
            android:icon="@drawable/ic_palette_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="experimental_screen_transitions"
            android:title="@string/settings_experimental_screen_transitions_title"
            android:summary="@string/settings_experimental_screen_transitions_summary"
            android:icon="@drawable/ic_speed_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="expressive_controls_preview"
            android:title="@string/settings_expressive_controls_preview_title"
            android:summary="@string/settings_expressive_controls_preview_summary"
            android:icon="@drawable/ic_animation_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="grayscale_off_icons"
            android:title="@string/settings_grayscale_off_icons_title"
            android:summary="@string/settings_grayscale_off_icons_summary"
            android:icon="@drawable/ic_palette_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="home_quick_move"
            android:title="@string/settings_home_quick_move_title"
            android:summary="@string/settings_home_quick_move_summary"
            android:icon="@drawable/ic_drag_handle"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="home_compact_cards"
            android:title="@string/settings_home_compact_cards_title"
            android:summary="@string/settings_home_compact_cards_summary"
            android:icon="@drawable/ic_space_dashboard_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <!-- Switch rows only (GrayableIconSwitchPreference); Compose switches keep the standard look. -->
        <rikka.preference.SimpleMenuPreference
            android:key="switch_row_design"
            android:title="@string/settings_switch_row_design_title"
            android:entries="@array/switch_row_designs"
            android:entryValues="@array/switch_row_designs_values"
            android:defaultValue="standard"
            android:icon="@drawable/ic_animation_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_experimental_in_development"
        android:title="@string/settings_experimental_category_in_development"
        android:icon="@drawable/ic_science_24"
        app:collapsible="false">

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="apps_controls_bottom"
            android:title="@string/settings_apps_controls_bottom"
            android:summary="@string/settings_apps_controls_bottom_summary"
            android:icon="@drawable/ic_search_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="usb_phone_switch_notify"
            android:title="@string/settings_usb_phone_switch_notify"
            android:summary="@string/settings_usb_phone_switch_notify_in_development"
            android:icon="@drawable/ic_adb_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="software_keystore_fallback_enabled"
            android:title="@string/settings_keystore_fallback"
            android:summary="@string/settings_keystore_fallback_in_development"
            android:icon="@drawable/ic_shield_24"
            android:defaultValue="false"
            app:badgeType="experimental"
            app:severityBadge="risky" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="display_tuner_plus_enabled"
            android:title="@string/settings_display_tuner_plus_title"
            android:summary="@string/settings_display_tuner_plus_summary"
            android:icon="@drawable/ic_smartphone_24"
            android:defaultValue="false"
            app:infoTitle="@string/help_display_tuner_plus_title"
            app:infoDetail="@string/help_display_tuner_plus_detail"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="window_manager_plus_enabled"
            android:title="@string/settings_window_manager_plus"
            android:summary="@string/settings_window_manager_plus_summary"
            android:icon="@drawable/ic_window_24"
            android:defaultValue="false"
            app:infoTitle="@string/help_window_manager_plus_title"
            app:infoDetail="@string/help_window_manager_plus_detail"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="overlay_manager_plus_enabled"
            android:title="@string/settings_overlay_manager_plus"
            android:summary="@string/settings_overlay_manager_plus_summary"
            android:icon="@drawable/ic_palette_24"
            android:defaultValue="false"
            app:infoTitle="@string/help_overlay_manager_plus_title"
            app:infoDetail="@string/help_overlay_manager_plus_detail"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="avf_manager_enabled"
            android:title="@string/settings_avf_manager_title"
            android:summary="@string/settings_avf_manager_summary"
            android:icon="@drawable/ic_server_24"
            android:defaultValue="false"
            app:infoTitle="@string/help_avf_manager_title"
            app:infoDetail="@string/help_avf_manager_detail"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="continuity_bridge_enabled"
            android:title="@string/settings_continuity_bridge_title"
            android:summary="@string/settings_continuity_bridge_summary"
            android:icon="@drawable/ic_devices_24"
            android:defaultValue="false"
            app:infoTitle="@string/help_continuity_bridge_title"
            app:infoDetail="@string/help_continuity_bridge_detail"
            app:badgeType="experimental" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_experimental"
        android:title="@string/settings_experimental_category_developer_previews"
        android:icon="@drawable/ic_science_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="spoof_device_enabled"
            android:title="@string/settings_spoof_device_experimental"
            android:summary="@string/settings_spoof_device_summary"
            android:icon="@drawable/ic_smartphone_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <rikka.preference.SimpleMenuPreference
            android:key="spoof_target"
            android:title="@string/settings_spoof_target"
            android:entries="@array/spoof_targets"
            android:entryValues="@array/spoof_targets_values"
            android:defaultValue="pixel_8_pro"
            android:dependency="spoof_device_enabled"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/ic_smartphone_24" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="experimental_root_compat"
            android:title="@string/settings_experimental_root_experimental"
            android:summary="@string/settings_experimental_root_summary"
            android:icon="@drawable/ic_science_24"
            android:defaultValue="false"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="ai_core_plus_enabled"
            android:title="@string/settings_ai_bridge_title"
            android:summary="@string/settings_ai_core_plus_summary"
            android:icon="@drawable/ic_integration_instructions_24"
            android:defaultValue="false"
            app:infoTitle="@string/help_ai_core_plus_title"
            app:infoDetail="@string/help_ai_core_plus_detail"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="ai_core_master_enabled"
            android:title="@string/settings_ai_core_master"
            android:summary="@string/settings_ai_core_master_summary"
            android:icon="@drawable/ic_integration_instructions_24"
            android:defaultValue="false"
            android:dependency="ai_core_plus_enabled"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="npu_acceleration_enabled"
            android:title="@string/settings_npu_acceleration"
            android:summary="@string/settings_npu_acceleration_summary"
            android:icon="@drawable/ic_settings_suggest_24"
            android:defaultValue="false"
            android:dependency="ai_core_master_enabled"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="native_window_crawler_enabled"
            android:title="@string/settings_window_crawler"
            android:summary="@string/settings_window_crawler_summary"
            android:icon="@drawable/ic_code_24"
            android:defaultValue="false"
            android:dependency="ai_core_master_enabled"
            app:badgeType="experimental" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="ai_core_experimental_enabled"
            android:title="@string/settings_ai_automation_experimental"
            android:summary="@string/settings_ai_automation_experimental_summary"
            android:icon="@drawable/ic_science_24"
            android:defaultValue="false"
            android:dependency="ai_core_plus_enabled"
            app:badgeType="experimental" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
