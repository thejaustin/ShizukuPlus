<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_debug"
        android:title="@string/settings_developer_category_debug"
        android:icon="@drawable/ic_code_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="notification_system_enabled"
            android:title="@string/settings_notification_system_title"
            android:summary="@string/settings_notification_system_summary"
            android:icon="@drawable/ic_outline_notifications_active_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="adaptive_recommendations_enabled"
            android:title="@string/settings_adaptive_recommendations_title"
            android:summary="@string/settings_adaptive_recommendations_summary"
            android:icon="@drawable/ic_settings_suggest_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="adb_loopback_probe_enabled"
            android:title="@string/settings_adb_loopback_probe_title"
            android:summary="@string/settings_adb_loopback_probe_summary"
            android:icon="@drawable/ic_adb_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="swipe_settings_sandbox"
            android:title="@string/settings_swipe_sandbox_title"
            android:summary="@string/settings_swipe_sandbox_summary"
            android:icon="@drawable/ic_swipe_24"
            android:defaultValue="false" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="setting_disabling_optional"
            android:title="@string/settings_setting_disabling_optional_title"
            android:summary="@string/settings_setting_disabling_optional_summary"
            android:icon="@drawable/ic_settings_suggest_24"
            android:defaultValue="false" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="hide_top_settings_with_navbar"
            android:title="@string/settings_hide_top_settings_with_navbar_title"
            android:summary="@string/settings_hide_top_settings_with_navbar_summary"
            android:icon="@drawable/ic_settings_outline_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="hide_backup_settings"
            android:title="@string/settings_hide_backup_settings"
            android:summary="@string/settings_hide_backup_settings_summary"
            android:icon="@drawable/ic_folder_24"
            android:defaultValue="false" />

        <Preference
            android:key="reset_recommendations"
            android:title="@string/settings_reset_recommendations_title"
            android:summary="@string/settings_reset_recommendations_summary"
            android:icon="@drawable/ic_settings_suggest_24" />

        <!-- Key kept from the old "Vector acceleration" row: all it ever did was offer a crash report on
             the next launch of a build without automatic crash reporting (MainActivity). -->
        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="vector_enabled"
            android:title="@string/settings_offer_crash_report_title"
            android:summary="@string/settings_offer_crash_report_summary"
            android:icon="@drawable/ic_bug_report_24"
            android:defaultValue="false" />

        <Preference
            android:key="manual_report"
            android:title="@string/manual_report_title"
            android:summary="@string/manual_report_summary"
            android:icon="@drawable/ic_server_error_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_unrestricted_access"
        android:title="@string/settings_developer_category_unrestricted"
        android:icon="@drawable/ic_warning_24"
        android:defaultValue="true">

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="unrestricted_app_data_enabled"
            android:title="@string/settings_unrestricted_app_data_title"
            android:summary="@string/settings_unrestricted_app_data_summary"
            android:icon="@drawable/ic_folder_24"
            android:defaultValue="false"
            app:badgeType="experimental"
            app:severityBadge="dangerous" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="unrestricted_personal_data_enabled"
            android:title="@string/settings_unrestricted_personal_data_title"
            android:summary="@string/settings_unrestricted_personal_data_summary"
            android:icon="@drawable/ic_shield_24"
            android:defaultValue="false"
            app:badgeType="experimental"
            app:severityBadge="dangerous" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
