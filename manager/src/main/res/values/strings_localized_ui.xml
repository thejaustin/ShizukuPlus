    <string name="settings_firewall_success_mocking_summary">Intercept and fake success for iptables rules when local netfilter permissions fail</string>
    <string name="settings_build_prop_redirection_explainer_title">About build.prop Redirection</string>
    <string name="settings_build_prop_redirection_explainer_detail">This module shadow-copies the original build.prop to a user-writable path and redirects all writes to it, allowing system values to be modified safely without Root.</string>
    <string name="settings_firewall_mocking_explainer_title">About Firewall Success Mocking</string>
    <string name="settings_firewall_mocking_explainer_detail">When rootless limitations prevent real rules from being set, this module fakes successful iptables results so firewall apps can continue working.</string>
    <string name="settings_overlayfs_ghosting_title">OverlayFS System Ghosting</string>
    <string name="settings_overlayfs_ghosting_summary">[Developer] Seamlessly mount virtual overlay filesystems to simulate rw /system for root apps. Warning: Highly experimental.</string>
    <string name="settings_kernel_driver_ghosting_title">Kernel Driver Ghosting</string>
    <string name="settings_kernel_driver_ghosting_summary">[Developer] Silently simulate success for insmod/rmmod kernel commands without loading the kernel modules.</string>
    <string name="settings_partition_flash_ghosting_title">Partition Flash Ghosting</string>
    <string name="settings_partition_flash_ghosting_summary">[Developer] Intercept and fake \'dd\' operations targeting /dev/block/. Prevents ROM flashers from crashing while doing nothing.</string>
    <string name="settings_power_state_ghosting_title">Power State Ghosting</string>
    <string name="settings_power_state_ghosting_summary">[Developer] Intercept reboot, recovery, and soft-reboot commands and silently ignore them to prevent unwanted device restarts.</string>
