<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">
    <!-- Flat-top hexagon, circumradius 120 units, centered at (216,216). Fills ~60 % of
         the 432-unit viewport while staying inside the 132-unit adaptive-icon safe zone.
         The previous hexagon (R≈88) was too small — only 41 % of the viewport — and its
         plus badge was barely 5dp wide at 48dp icon size, making it invisible in practice
         (issue #530). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 336,216 L 276,112 L 156,112 L 96,216 L 156,320 L 276,320 Z" />
    <!-- Plus badge centered exactly on the top-right vertex (276, 112). Half the badge
         overlaps the hexagon fill so the outer arms — pointing up and right — read as a
         clear plus badge after the launcher applies its single tint color. W=68, arm=20. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 266,78 h 20 v 24 h 24 v 20 h -24 v 24 h -20 v -24 h -24 v -20 h 24 Z" />
</vector>
