<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">
    <!-- Filled hexagon silhouette — the launcher/system applies a single tint color in
         themed-icon / monochrome mode, so the icon must be an opaque filled shape rather
         than a stroke outline (the previous stroke-only design rendered as a sparse ring
         that looked broken under Pixel Launcher's minimal mode, issue #530). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 311.0,224.0 L 266.75,300.64 L 178.25,300.64 L 134.0,224.0 L 178.25,147.36 L 266.75,147.36 Z" />
    <!-- Plus badge at upper-right shoulder — same coordinates as ic_launcher_foreground.xml
         (×4 viewport scale). Positioned mostly outside the hexagon boundary so it remains
         legible as a badge when both paths are filled with the same tint. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 277.88,141.50 h 14.25 v 21.38 h 21.38 v 14.25 h -21.38 v 21.38 h -14.25 v -21.38 h -21.38 v -14.25 h 21.38 z" />
</vector>
